
<!DOCTYPE html>
<html>
<head>
    <title><%= game.title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <!-- Incluimos la cabecera -->
    <%- include("partials/header") %>

    <!-- Página individual del videojuego -->
    <section class="game">

        <!-- Mostramos el título del videojuego -->
        <h2><%= game.title %></h2>

        <!-- Mostramos la imagen del videojuego -->
        <img src="<%= game.image %>" alt="<%= game.alt %>">

        <!-- Mostramos la descripción -->
        <p><%- game.description %></p>

        <!-- Mostramos la categoría -->
        <p>Category: <%= game.categoria %></p>

        <!-- Mostramos la puntuación de Metacritic -->
        <p>Metacritic: <%= game.metacritic %></p>

        <!-- Mostramos la posición en el ranking -->
        <p>Ranking: <%= game.ranking %></p>

        <!-- Enlace para volver al ranking -->
        <a href="/">Volver al ranking</a>

    </section>

    <!-- Incluimos el footer -->
    <%- include("partials/footer") %>

</body>
</html>
